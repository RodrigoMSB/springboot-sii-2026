<?xml version="1.0" encoding="UTF-8"?>
<!--
  dgt-tramites-api — el backend de la Dirección General de Tributación.

  Tronco de referencia del curso (SPEC-005). Los labs tallan de aquí sus
  starter/ y solucion/. Sin Lombok y sin Kotlin a propósito (D-003): los
  constructores y los accessors escritos a mano también son contenido.

  Las versiones NO se declaran cuando el BOM de Boot 4.1.0 ya las gestiona.
  Verificado contra spring-boot-dependencies-4.1.0.pom, no de memoria:
    flyway 12.4.0 · junit-jupiter 6.0.3
    postgresql 42.7.11 · awaitility 4.3.0

  Este lab añade UNA dependencia sobre la del Lab 07: WireMock 3.13.1, el
  doble de Tesorería. Llega como librería y corre in-process — ni imagen, ni
  contenedor, ni proceso aparte (SPEC-025).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <groupId>cl.dgt</groupId>
  <artifactId>dgt-tramites-api</artifactId>
  <version>0.1.0</version>
  <name>dgt-tramites-api</name>
  <description>API de trámites de la Dirección General de Tributación</description>

  <properties>
    <java.version>25</java.version>
    <!-- ArchUnit CORE, no archunit-junit5: las reglas son @Test Jupiter comunes
         con ClassFileImporter, inmunes a la versión del runner (SPEC-000 §6,
         nota 1; validado por el spike S-1). -->
    <archunit.version>1.4.2</archunit.version>
    <!-- Zonky: PostgreSQL de verdad, empaquetado como artefacto Maven. La versión
         de los BINARIOS (16.x) es independiente de la del envoltorio Java. -->
    <zonky.version>2.2.2</zonky.version>
    <zonky.binarios.version>16.14.0</zonky.binarios.version>
    <!-- WireMock como LIBRERÍA, no como imagen. Es el doble de TESO (D-002).
         3.13.1 es la última estable de la línea 3; la 4.0.0 sigue en beta y
         este material no se entrega a una institución del Estado sobre una
         beta. Verificado contra Maven Central, no de memoria (SPEC-025). -->
    <wiremock.version>3.13.1</wiremock.version>
    <!-- La versión de Jetty que WireMock declara y contra la que está probado.
         Se aplica por BOM, abajo; NO por la propiedad `jetty.version` de Boot.
         Ver la nota del dependencyManagement: tocar esa propiedad rompe el BOM
         de Boot, y también está medido. -->
    <jetty.wiremock.version>12.0.16</jetty.wiremock.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- El BOM alinea todos los artefactos de binarios a la misma versión de
           PostgreSQL, sea cual sea la plataforma. -->
      <dependency>
        <groupId>io.zonky.test.postgres</groupId>
        <artifactId>embedded-postgres-binaries-bom</artifactId>
        <version>${zonky.binarios.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- =================== Jetty, para que WireMock arranque ===================
           El problema, medido y no supuesto: Boot 4.1.0 gestiona
           `org.eclipse.jetty:*` en 12.1.10, pero NO gestiona
           `org.eclipse.jetty.ee10:*`, que llegaba en 12.0.16 desde el BOM de
           WireMock. El classpath quedaba PARTIDO entre dos Jetty y se rompía por
           donde tenía que romperse: `jetty-ee10-servlet-12.0.16` llama a
           `Environment.ensure(String)`, un método que en `jetty-util-12.1.10` ya
           no existe. Síntoma: NoSuchMethodError al arrancar el TESO simulado.

           Se alinea A LA BAJA, a la versión que WireMock declara y contra la que
           está probado, en vez de subir ee10 a una que WireMock no ha visto.

           Y se hace por BOM, no con la propiedad `jetty.version` de Boot: esa
           propiedad la usa el BOM de Boot para importar `jetty-ee11-bom`, que en
           12.0.16 NO EXISTE (ee11 nace con Jetty 12.1). Bajarla rompe la lectura
           del POM antes de compilar nada. También medido.

           El radio de impacto es exactamente WireMock: esta aplicación corre
           sobre TOMCAT, y Jetty solo está en el classpath porque lo trae el
           simulador de TESO. -->
      <dependency>
        <groupId>org.eclipse.jetty</groupId>
        <artifactId>jetty-bom</artifactId>
        <version>${jetty.wiremock.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.eclipse.jetty.ee10</groupId>
        <artifactId>jetty-ee10-bom</artifactId>
        <version>${jetty.wiremock.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- Boot 4 sacó las autoconfiguraciones a módulos: `flyway-core` por sí solo
         NO enciende Flyway al arrancar. Sin esto, Hibernate valida contra una base
         vacía y muere con "missing table [adjunto]". Verificado, no supuesto. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-flyway</artifactId>
    </dependency>

    <!-- Flyway 12 separa el soporte por motor: core + el módulo de PostgreSQL. -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- OpenAPI 3 + Swagger UI. springdoc 3.x es la línea para Spring Boot 4
         (la 2.x era para Boot 3). Verificado contra Maven Central, no de memoria. -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>3.0.3</version>
    </dependency>

    <!-- ======================== seguridad (M9) ======================== -->
    <!-- El portero: la cadena de filtros, BCrypt, @PreAuthorize. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <!-- Resource Server + JOSE (Nimbus): decodifica y VALIDA el JWT (la firma), y
         trae el JwtEncoder para emitirlo. Un starter, las dos mitades. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>

    <!-- ====================== PostgreSQL embebido ====================== -->
    <!-- El alumno jamás escribe una cadena de conexión: la levanta
         BaseDeDatosEmbebida, en el perfil dev.

         SCOPE, y por qué no es `test`: la clase que arranca la base vive en
         src/main (es el reemplazo del compose para el perfil dev), así que hay
         que COMPILAR contra Zonky. Va como `optional` para que no se propague a
         nadie que algún día dependa de este artefacto: es andamiaje de
         desarrollo, no parte de la API. -->
    <dependency>
      <groupId>io.zonky.test</groupId>
      <artifactId>embedded-postgres</artifactId>
      <version>${zonky.version}</version>
      <optional>true</optional>
    </dependency>

    <!-- Los binarios de PostgreSQL, uno por plataforma. Se declaran los DOS a
         propósito: el alumno del SII va en Windows y el material se prepara en
         un Mac con Apple Silicon. Ambos jars viajan en el repositorio, así que
         cualquiera de las dos máquinas resuelve sin tocar la red. -->
    <dependency>
      <groupId>io.zonky.test.postgres</groupId>
      <artifactId>embedded-postgres-binaries-windows-amd64</artifactId>
      <scope>runtime</scope>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>io.zonky.test.postgres</groupId>
      <artifactId>embedded-postgres-binaries-darwin-arm64v8</artifactId>
      <scope>runtime</scope>
      <optional>true</optional>
    </dependency>

    <!-- ========================= TESO simulado ========================= -->
    <!-- WireMock, el doble de Tesorería. Antes era un servicio del compose
         (imagen wiremock/wiremock); ahora es la librería que esa imagen
         envuelve, corriendo dentro del mismo proceso (SPEC-025 · D-025-1/2).

         SCOPE, por el mismo motivo que Zonky: el simulador del perfil dev vive
         en src/main —es el reemplazo del servicio del compose—, así que hay que
         COMPILAR contra él. `optional` para que no se propague: es andamiaje de
         laboratorio, no parte de la API. En un proyecto real TESO existe de
         verdad y este bloque no estaría. -->
    <!-- `wiremock-jetty12`, y NO el artefacto `wiremock` a secas. El de base trae
         el servidor HTTP para Jetty 11; Boot 4.1 va en Jetty 12, y con ese en el
         classpath WireMock aborta al arrancar con «Jetty 11 is not present and no
         suitable HttpServerFactory extension was found». Medido, no supuesto:
         primero se probó el artefacto de base y falló así (SPEC-025). -->
    <dependency>
      <groupId>org.wiremock</groupId>
      <artifactId>wiremock-jetty12</artifactId>
      <version>${wiremock.version}</version>
      <optional>true</optional>
    </dependency>

    <!-- ============================ test ============================ -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Boot 4 sacó los slices de test a módulos propios: @WebMvcTest ya no viaja
         dentro de spring-boot-starter-test. Verificado: ningún jar del starter lo
         contiene; vive en spring-boot-webmvc-test (versión gestionada por el BOM). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- @WithMockUser y utilidades de seguridad para los tests (rebanadas). -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Los @DisplayName narrativos se leen como especificación: que surefire los
           muestre en la consola, no el nombre del método. La suite en rojo debe leerse
           como una lista de compromisos (SPEC-009 §2). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <statelessTestsetReporter implementation="org.apache.maven.plugin.surefire.extensions.junit5.JUnit5Xml30StatelessReporter">
            <usePhrasedTestCaseMethodName>true</usePhrasedTestCaseMethodName>
          </statelessTestsetReporter>
          <systemPropertyVariables>
            <!-- Ver la nota del failsafe, abajo. -->
            <dgt.teso-simulado.enabled>false</dgt.teso-simulado.enabled>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <!-- Los *IT son pruebas de integración: las corre `verify`, no `test`.
           El parent gestiona la versión, pero no engancha las ejecuciones. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <!-- El TESO simulado del perfil dev se APAGA en la suite, y hay que
                 apagarlo aquí y no en cada test.

                 Por qué hace falta: los tests corren con el perfil `dev` activo
                 (spring.profiles.active tiene default dev), así que TesoSimuladoDev
                 se cargaría en CADA contexto e intentaría atarse al 8089 fijo — el
                 segundo contexto encontraría el puerto tomado por el primero. Y
                 sobraría: los IT de resiliencia levantan su propio TESO en un puerto
                 dinámico, que es lo que les permite gobernarlo por API Java.

                 Por qué en el plugin: la alternativa era añadir la propiedad a la
                 anotación de cada IT, y la mayoría de esos archivos se HEREDAN del
                 Lab 07 byte a byte. Tocarlos los haría divergir de su base sin que
                 el lab lo necesite. Una línea aquí, en el único archivo que este lab
                 sí declara como propio, en lugar de once divergencias. -->
            <dgt.teso-simulado.enabled>false</dgt.teso-simulado.enabled>
          </systemPropertyVariables>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
