%% =============================================================================
%%  El mismo mapa, con dgt-contribuyentes caído — el crimen del bloque 2
%% -----------------------------------------------------------------------------
%%  Lo importante de este diagrama es lo que NO cambia. El contribuyente sigue
%%  entrando. El portal sigue enrutando. dgt-tramites sigue respondiendo 200 con
%%  un JSON bien formado.
%%
%%  Lo único que cambia es un campo que viene en null, y no hay ni un símbolo
%%  rojo en la pantalla del usuario que lo diga. Ese silencio es el crimen.
%% =============================================================================
graph TB
    Nav["🌐 El contribuyente<br/>(no se entera de nada)"]

    Portal["dgt-portal<br/>Gateway · 8099<br/>✅ responde igual"]

    Tram["dgt-tramites<br/>✅ HTTP 200<br/>⚠️ nombreContribuyente: null"]

    Con1["dgt-contribuyentes 1<br/>💀 APAGADO"]
    Con2["dgt-contribuyentes 2<br/>💀 APAGADO"]

    CB{{"Circuit Breaker<br/>CERRADO ➜ ABIERTO<br/>tras N fallos"}}
    FB["fichaDegradada()<br/>rut: sí · razonSocial: null"]

    Reg["dgt-registro · 8761<br/>✅ vivo, y tacha a los muertos"]
    Conf["dgt-config · 8888<br/>✅ vivo"]

    DBt[("dgt_tramites<br/>✅ intacta")]
    DBc[("dgt_contribuyentes<br/>😴 nadie la consulta")]

    Nav -->|"HTTP :8099"| Portal
    Portal -->|"lb://dgt-tramites"| Tram
    Tram --> DBt
    Tram --> CB
    CB -.->|"❌ no contesta"| Con1
    CB -.->|"❌ no contesta"| Con2
    CB ==>|"se rinde y llama al"| FB
    FB ==>|"devuelve ficha incompleta"| Tram

    Con1 -.-> DBc
    Con2 -.-> DBc
    Tram -.-> Reg
    Tram -.-> Conf
    Portal -.-> Reg

    Nota["Lo que el usuario ve:<br/>HTTP 200 · JSON válido · sin errores<br/>Lo que le falta: el titular de su declaración"]
    Nav -.-> Nota

    classDef muerto fill:#fbeeee,stroke:#8a3333,stroke-width:2px,stroke-dasharray:4 3
    classDef vivo fill:#f3f8ef,stroke:#4a7a33,stroke-width:1px
    classDef aviso fill:#fdf6e3,stroke:#8a6a1f,stroke-width:2px
    class Con1,Con2 muerto
    class Portal,Tram,Reg,Conf vivo
    class CB,FB,Nota aviso
