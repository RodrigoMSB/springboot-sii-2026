<?xml version="1.0" encoding="UTF-8"?>
<!--
  =============================================================================
   dgt-portal — la única puerta al exterior (API Gateway)
  .............................................................................
   ⚠️  TRAMPA DE VERSIONES, y le pasa a todo el mundo:

   El artefacto NO se llama `spring-cloud-starter-gateway`. Ese nombre existió
   hasta la serie 4.3.x y ESTÁ MUERTO en el tren 2025.1.x — el último publicado
   es 4.3.5. En Spring Cloud 5.x el Gateway se partió en dos, y hay que ELEGIR:

     · spring-cloud-starter-gateway-server-webmvc   -> bloqueante, sobre Servlet
     · spring-cloud-starter-gateway-server-webflux  -> reactivo, sobre Netty

   Aquí se usa el WEBMVC, a propósito: el curso entero se construyó sobre Spring
   MVC bloqueante. Meter el modelo reactivo en la última sesión, sin haberlo
   enseñado nunca, sería regalarle al alumno un stack que no sabe depurar el día
   que falle. El reactivo es mejor para un gateway con mucha concurrencia — y eso
   se dice en la teoría, con su porqué, en vez de colarlo por la puerta de atrás.

   El LoadBalancer viene aparte y es lo que hace que `lb://dgt-contribuyentes`
   signifique algo: sin él, el gateway no sabe traducir un nombre lógico a una
   lista de instancias.
  =============================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cl.dgt</groupId>
        <artifactId>dgt-sistema</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>dgt-portal</artifactId>
    <name>dgt-portal</name>
    <description>API Gateway: una sola puerta, N servicios detrás</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway-server-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-config</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
