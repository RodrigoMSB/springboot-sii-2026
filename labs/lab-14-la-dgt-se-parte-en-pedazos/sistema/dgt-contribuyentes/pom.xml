<?xml version="1.0" encoding="UTF-8"?>
<!--
  =============================================================================
   dgt-contribuyentes — el proveedor: quién es el dueño de un RUT
  .............................................................................
   La pieza que se va a MATAR en el bloque 2 y a DUPLICAR en el bloque 3.

   Tiene BASE DE DATOS PROPIA (`dgt_contribuyentes`), con su usuario propio, y
   ningún otro servicio del sistema tiene credenciales para entrar. Eso no es
   decoración: es la regla que convierte un módulo en un microservicio. Si
   `dgt-tramites` pudiera hacer un JOIN contra esta tabla, no habría dos
   servicios — habría un monolito con dos procesos y una latencia de red gratis.

   Flyway, no `ddl-auto=update` (corrección 3 de la SPEC-020 §6): el esquema es
   un artefacto versionado, igual que en el Lab 06. No vamos a contradecir en la
   última sesión lo que se enseñó en la sexta.
  =============================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cl.dgt</groupId>
        <artifactId>dgt-sistema</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>dgt-contribuyentes</artifactId>
    <name>dgt-contribuyentes</name>
    <description>Servicio de contribuyentes: el proveedor</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- Boot 4 sacó las autoconfiguraciones a módulos propios: `flyway-core`
             por sí solo NO enciende Flyway al arrancar. Sin esta dependencia,
             Hibernate valida contra una base vacía y el servicio muere con
             "missing table". Es la misma nota que lleva el pom del tronco. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-config</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
