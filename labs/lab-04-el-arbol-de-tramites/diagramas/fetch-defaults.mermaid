%% "No declarar el fetch" no es neutral: el default difiere por anotación.
flowchart TB
    Q["pides UN trámite"]
    Q --> MT["@ManyToOne contribuyente"]
    Q --> OM["@OneToMany adjuntos"]
    MT -->|"sin fetch → default EAGER"| WALL["viaja cargado<br/>(el muro)"]
    MT -->|"fetch = LAZY (correcto)"| PROXY["proxy, no se toca"]
    OM -->|"sin fetch → default LAZY"| LAZYOK["no se toca"]
    classDef mal fill:#fee,stroke:#c00
    class WALL mal
