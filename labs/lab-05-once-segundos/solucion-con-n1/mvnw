#!/usr/bin/env bash
# =============================================================================
#  mvnw — el Maven de este curso (SPEC-022 · D-022-2)
# -----------------------------------------------------------------------------
#  Esto YA NO es el Maven Wrapper de Apache. El wrapper original era un
#  DESCARGADOR: al primer uso se bajaba una distribución de Maven de internet.
#  En las máquinas del SII no hay internet, así que el wrapper se quedaba
#  colgado en el primer comando del primer día.
#
#  Este shim no descarga nada. Usa el Maven que viaja DENTRO del repositorio
#  (tools/maven) y el repositorio de dependencias que viaja con él
#  (repo-maven). Por eso funciona en modo avión: no hay nada que traer.
#
#  Para ti no cambia nada. Sigue siendo:
#
#      ./mvnw test
#      ./mvnw spring-boot:run
#
#  ---------------------------------------------------------------------------
#  DGT_ONLINE=1 · solo para quien PREPARA el material
#
#      DGT_ONLINE=1 ./mvnw verify
#
#  Omite el modo offline y el repositorio embebido, y sale a internet como un
#  Maven normal. Es lo que usamos nosotros para capturar dependencias nuevas.
#  El alumno no lo necesita nunca.
# =============================================================================
set -uo pipefail

# La raíz del repositorio, subiendo por el árbol hasta dar con el marcador.
# Sin git, sin rutas absolutas y sin variables de entorno: así el material
# sigue funcionando si el alumno lo clona donde se le antoje.
DIR_PROYECTO="$(cd "$(dirname "$0")" && pwd)"
RAIZ="$DIR_PROYECTO"
while [ ! -x "$RAIZ/tools/maven/bin/mvn" ]; do
    PADRE="$(dirname "$RAIZ")"
    if [ "$PADRE" = "$RAIZ" ]; then
        printf '[ERROR] No encuentro tools/maven/ subiendo desde:\n'   >&2
        printf '        %s\n'                                          "$DIR_PROYECTO" >&2
        printf '\n'                                                    >&2
        printf '        Este proyecto tiene que vivir DENTRO del repositorio del\n' >&2
        printf '        curso. Si copiaste la carpeta a otro sitio, vuelve a\n'     >&2
        printf '        trabajar sobre el clon original.\n'                          >&2
        exit 1
    fi
    RAIZ="$PADRE"
done

MVN="$RAIZ/tools/maven/bin/mvn"

if [ "${DGT_ONLINE:-0}" = "1" ]; then
    exec "$MVN" "$@"
fi

exec "$MVN" --offline "-Dmaven.repo.local=$RAIZ/repo-maven" "$@"
