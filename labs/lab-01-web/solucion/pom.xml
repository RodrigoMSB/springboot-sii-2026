<?xml version="1.0" encoding="UTF-8"?>
<!--
  Lab 01 — Web: el primer endpoint.

  Una sola dependencia más que el Lab 00: `spring-boot-starter-web`. Esa línea es
  la que hace que la aplicación deje de terminar y se quede escuchando.

      ./mvnw spring-boot:run
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <!-- La versión del FORMATO del pom, no la del proyecto. -->
  <modelVersion>4.0.0</modelVersion>

  <!-- Igual que en el Lab 00: el padre pone las versiones de todo y la
       configuración del compilador, para no repetirlas en cada proyecto. -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <groupId>cl.dgt</groupId>
  <artifactId>lab01-web</artifactId>
  <version>0.1.0</version>
  <name>lab01-web</name>
  <description>Lab 01 — Web: el primer endpoint</description>

  <properties>
    <java.version>25</java.version>
  </properties>

  <dependencies>
    <!--
      LA LÍNEA QUE CAMBIA TODO EL LABORATORIO.

      Respecto al Lab 00 solo cambia esto: `spring-boot-starter` pasa a ser
      `spring-boot-starter-web`. Y trae tres cosas de golpe:

       · TOMCAT embebido — el servidor. Por él la aplicación deja de terminar.
       · SPRING WEB MVC — el mecanismo que lee las anotaciones @GetMapping y
         enruta cada petición al método que le toca.
       · JACKSON — el que convierte objetos Java en JSON y al revés. Es quien
         hace que devolver un `record` se vea con llaves en el navegador.

      Ninguna de las tres se pide por su nombre. Vienen dentro del starter, y
      @EnableAutoConfiguration las encuentra en el classpath y las configura.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- El que aporta la meta `spring-boot:run` que se usa todo el curso. -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <!-- El `repackage` queda apagado a propósito.

             Ese goal construye el "fat jar" ejecutable: un solo archivo con la
             aplicación y TODAS sus dependencias dentro — Spring, Tomcat, y lo
             que haga falta—, y por eso pesa decenas de MB.

             En este laboratorio no se usa nunca: se corre con `spring-boot:run`,
             que ejecuta las clases directamente y no necesita empaquetar nada.
             `./mvnw package` sigue funcionando y deja el jar normal, de unos
             pocos KB.

             Para volver a activarlo, borrar este bloque <executions>. -->
        <executions>
          <execution>
            <id>repackage</id>
            <phase>none</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
