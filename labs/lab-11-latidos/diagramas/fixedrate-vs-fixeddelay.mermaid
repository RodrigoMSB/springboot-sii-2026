%% Por qué fixedRate puede solaparse y fixedDelay no.
%% La diferencia solo se ve cuando el trabajo dura MÁS que el intervalo — es decir,
%% el día que la base creció. Por eso el bug nunca aparece en desarrollo.
gantt
    title fixedRate (inicio→inicio) vs fixedDelay (fin→inicio) · intervalo 10s, trabajo 14s
    dateFormat X
    axisFormat %Ss

    section fixedRate · SE SOLAPAN
    ejecución 1 (14s)      :crit, r1, 0, 14
    ejecución 2 (arranca a los 10s, sin esperar)  :crit, r2, 10, 24
    ejecución 3            :crit, r3, 20, 34

    section fixedDelay · JAMÁS
    ejecución 1 (14s)      :done, d1, 0, 14
    espera 10s             :active, d2, 14, 24
    ejecución 2            :done, d3, 24, 38
