<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <groupId>cl.dgt</groupId>
  <artifactId>lab12-empaquetado-solucion</artifactId>
  <version>0.1.0</version>
  <name>lab12-empaquetado-solucion</name>
  <description>Lab 12 — Empaquetado: la solución</description>

  <properties>
    <java.version>25</java.version>
    <jib.version>3.5.2</jib.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Hoy el `repackage` SÍ se ejecuta: el jar ejecutable es el contenido del paso 1.
           En los demás labs está apagado porque no se usa nunca. -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <!-- El jar por capas: dependencias y código propio en capas distintas (paso 2). -->
          <layers>
            <enabled>true</enabled>
          </layers>
        </configuration>
      </plugin>

      <!-- Imagen OCI sin demonio Docker (paso 4). -->
      <plugin>
        <groupId>com.google.cloud.tools</groupId>
        <artifactId>jib-maven-plugin</artifactId>
        <version>${jib.version}</version>
        <configuration>
          <from>
            <image>eclipse-temurin:25-jre</image>
          </from>
          <to>
            <image>lab12-empaquetado:0.1.0</image>
          </to>
          <container>
            <ports>
              <port>8106</port>
            </ports>
            <environment>
              <SPRING_PROFILES_ACTIVE>prod</SPRING_PROFILES_ACTIVE>
            </environment>
          </container>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
