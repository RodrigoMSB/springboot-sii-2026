<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <!-- La versión del FORMATO del pom, no la del proyecto. Es 4.0.0 desde hace
       más de quince años y no se toca nunca. -->
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <!-- Vacío a propósito: significa «no busques el pom del padre en una carpeta
         de al lado, bájalo del repositorio». -->
    <relativePath/>
  </parent>

  <!-- Las tres coordenadas que identifican este proyecto. Juntas forman el
       nombre del jar que sale al empaquetar: lab00-hola-mundo-0.1.0.jar -->
  <groupId>cl.dgt</groupId>
  <artifactId>lab00-hola-mundo</artifactId>
  <version>0.1.0</version>

  <!-- Solo para humanos: aparecen en los informes de Maven. No afectan a nada. -->
  <name>lab00-hola-mundo</name>
  <description>Lab 00 — que Spring Boot arranque</description>

  <properties>
    <java.version>25</java.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>repackage</id>
            <phase>none</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
