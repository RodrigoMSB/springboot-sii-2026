%% Por qué la entidad no cruza la frontera, y quién lo vigila.
flowchart LR
    DB[(base de datos)] --> E["Contribuyente @Entity<br/>rut · razonSocial<br/>puntajeRiesgoInterno ⚠️"]
    E --> SVC["FichaService<br/>(capa application)"]
    SVC -->|lista blanca: elige 2 campos| DTO["FichaContribuyenteDTO<br/>rut · razonSocial"]
    DTO --> C["FichaController<br/>@RestController"]
    C --> JSON["JSON público<br/>sin el puntaje"]

    E -.->|"AU-02 lo prohíbe<br/>(incluso en el genérico)"| C
    linkStyle 5 stroke:#c00,stroke-dasharray:5

    classDef peligro fill:#fee,stroke:#c00
    class E peligro
