<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <groupId>cl.dgt</groupId>
  <artifactId>microservicios-gateway-docker</artifactId>
  <version>0.1.0</version>
  <name>microservicios-gateway-docker</name>
  <description>Lab 14 — Microservicios · gateway — la solución</description>

  <properties>
    <java.version>25</java.version>
    <resilience4j.version>2.3.0</resilience4j.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>

    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-circuitbreaker</artifactId>
      <version>${resilience4j.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        ================================================================
         POR QUÉ · aquí el `repackage` SÍ corre, y en el lab no
        ================================================================
         QUÉ HACE · empaqueta el jar ejecutable con todas sus
         dependencias dentro. Es lo que la imagen de Docker copia y lo
         que el `java -jar` del ENTRYPOINT arranca.

         ALTERNATIVAS · dejarlo apagado, como en el laboratorio, y
         construir la imagen con el jar fino más un directorio de
         dependencias aparte (que es lo que hace Jib en el Lab 13).

         POR QUÉ ESTA · porque en el laboratorio nadie empaqueta nada:
         se corre con `./mvnw spring-boot:run`, y empaquetar cuatro
         servicios en cada compilación del CI costaría tiempo a cambio
         de un artefacto que nadie usa. Aquí es al revés: el jar
         ejecutable ES lo que se despliega, y sin él no hay imagen.

         Es una de las cuatro diferencias declaradas con el lab 14, y
         `tools/verificar-demo-docker.py` la conoce y la permite.
        ================================================================
      -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
